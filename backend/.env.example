# ==============================================================================
# TerraRisk AI - Backend Environment Configuration Template
# Copy this file to `backend/.env` and supply actual values for your deployment.
# ==============================================================================

# Server Environment & Security
FLASK_ENV=production
PORT=5000
DATABASE_PATH=data/disaster_platform.db
# REQUIRED in production: Secure random 256-bit secret key for JWT signing
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# ==============================================================================
# Supabase Cloud Database Connection (PostgreSQL)
# ==============================================================================
# In production (Render, Railway, Fly.io, etc.), set DATABASE_URL to your Supabase
# connection string. When provided, the backend connects directly to Supabase.
# Recommended: Use Supabase Connection Pooler (port 6543 or 5432, Transaction or Session mode):
# Example: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase API & Realtime Gateway (Optional: For storage buckets or client events)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=your_supabase_anon_key_or_service_role_key

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
# Example: https://terrarisk.gov.in,https://admin.terrarisk.gov.in,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Weather & Satellite Telemetry (OpenWeatherMap API)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Cellular SMS Gateway (Twilio) - Optional: Simulated locally if empty
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
YOUR_PERSONAL_MOBILE=+919999900000

# Free Telegram Emergency Channel Bot - Optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Computer Vision AI Gateways (Gemini / OpenAI / Groq) - Optional: Heuristic fallback active if empty
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Production Transactional SMTP Email (Verification OTPs & Incident Bulletins)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=TerraRisk AI <alerts@terrarisk.gov.in>
SMTP_USE_TLS=true
